<section class="contact-section section-full-alt">
  <div class="contact-split" data-reveal-group>
    <div class="contact-info" data-reveal>
      <h2>Let's Build Something Great</h2>
      <p>Have a project in mind?<br />We'd love to hear about it.</p>

      <ul class="contact-details">
        <li>
          <span class="material-symbols-outlined">call</span>
          <a href="tel:{{ site.phone }}">
            {{ site.phone }}
          </a>
        </li>

        <li>
          <span class="material-symbols-outlined">mail</span>
          <a href="mailto:{{ site.email }}">
            {{ site.email }}
          </a>
        </li>

        <li>
          <span class="material-symbols-outlined">location_on</span>
          <span>
            <a href="{{ site.addressLink }}" target="_blank" rel="noopener noreferrer">
              {{ site.address.street }}, {{ site.address.city }}, {{ site.address.region }} {{ site.address.postalCode }}
            </a>
          </span>
        </li>
      </ul>
    </div>

    <div class="contact-form-container" data-reveal>

      <div class="contact-form-content">
        <h2>Send us a Message</h2>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify
          class="contact-form"
        >

          <input type="hidden" name="form-name" value="contact">

          <div class="form-row">
            <input
              type="text"
              name="name"
              placeholder="Name*"
              required
            />

            <input
              type="email"
              name="email"
              placeholder="Email*"
              required
            />

            <input
              type="tel"
              name="phone"
              placeholder="Phone*"
              required
            />
          </div>

          <textarea
            name="message"
            placeholder="Message*"
            rows="5"
            required
          ></textarea>

          <button type="submit" class="btn btn-secondary">
            Submit
          </button>

          <p class="micetype">
            By submitting this form, you agree that Ridgeway Services & Construction Ltd.
            may use your information to respond to your inquiry.
          </p>

        </form>
      </div>


      <div class="form-success" hidden>
        <span class="material-symbols-outlined">check_circle</span>

        <h2>Thank you!</h2>

        <p>
          Your message has been sent successfully.
          We'll be in touch soon.
        </p>
      </div>

    </div>
  </div>
</section>