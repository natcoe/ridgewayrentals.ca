<section class="contact-section">
  <div class="contact-box" data-reveal>
    <h3>Send Us a Message</h3>
    <p>Have a question about disposal bin rentals? Fill out the form and our team will get back to you shortly.</p>
    <div class="contact-grid">
      <div class="contact-form-content">
        <form 
          id="contact-form"
          name="contact"
          method="POST" 
          data-netlify="true"
          class="contact-form"
        >
          <input type="hidden" name="form-name" value="contact" />
          <div class="form-row">
            <input type="text" name="name" placeholder="Name*" required />
            <input type="email" name="email" placeholder="Email*" required />
            <input type="tel" name="phone" placeholder="Phone*" required />
          </div>
          <textarea name="message" placeholder="How can we help?*" rows="4" required></textarea>

          <div class="marketing-consent micetype">
            <p><strong>Optional marketing communications</strong></p>
            <p>
              Ridgeway Rentals Disposal Solutions<br />
              837 Hwy 6 N, Hamilton, ON L8P 1A1<br />
              365-925-0155 · sales@ridgewayrentals.ca
            </p>

            <label>
              <input type="checkbox" name="email-marketing-consent" value="yes" />
              <span>
                I'd like to receive occasional emails from Ridgeway Rentals about promotions,
                special offers, disposal services, and company updates. I can unsubscribe at any time.
              </span>
            </label>

            <label>
              <input type="checkbox" name="sms-marketing-consent" value="yes" />
              <span>
                I'd like to receive occasional text messages from Ridgeway Rentals about promotions,
                special offers, disposal services, and company updates. I can unsubscribe at any time.
              </span>
            </label>
          </div>

          <button type="submit" class="btn btn-secondary">Send Message</button>
        </form>

        <div class="contact-form-success" hidden tabindex="-1">
          <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
          <h4>Thank you!</h4>
          <p>Your message has been sent. We'll be in touch soon.</p>
        </div>
      </div>

      <div class="contact-direct-contact">
        <h4>Direct Contact</h4>
        <ul class="contact-details">
          <li>
            <span class="material-symbols-outlined">call</span>
            <a href="tel:{{ site.phone }}">{{ site.phone }}</a>
          </li>
          <li>
            <span class="material-symbols-outlined">mail</span>
            <a href="mailto:{{ site.email }}">{{ site.email }}</a>
          </li>
          <li>
            <span class="material-symbols-outlined">location_on</span>
            <a href="{{ site.addressLink }}" target="_blank" rel="noopener noreferrer">
              {{ site.address.street }}, {{ site.address.city }}, {{ site.address.region }} {{ site.address.postalCode }}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>