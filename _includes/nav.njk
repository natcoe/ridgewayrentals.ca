{% macro isActiveTree(item, currentUrl) %}
{%- if item.url == currentUrl -%}
  true
{%- elif item.children and item.children.length > 0 -%}
  {%- set results = [] -%}
  {%- for child in item.children -%}
    {%- set _ = results.push(isActiveTree(child, currentUrl)) -%}
  {%- endfor -%}
  {{ "true" if "true" in results.join("") else "false" }}
{%- else -%}
  false
{%- endif -%}
{% endmacro %}


{% macro renderNav(items, currentUrl, level=1) %}

{% for item in items %}

{% set hasChildren = item.children and item.children.length > 0 %}
{% set isActive = (item.url == currentUrl) %}
{% set isActiveTreeItem = hasChildren and isActiveTree(item, currentUrl) == "true" %}

<div class="
  {% if level == 1 %}
    nav-item
  {% else %}
    submenu-item
  {% endif %}
  {% if hasChildren %}
    has-children
  {% endif %}
  {% if isActiveTreeItem %}
    has-active
  {% endif %}
">


{% if hasChildren %}


    <div class="menu-header">

        <a href="{{ item.url }}" class="nav-link {% if isActive %}active{% endif %}">
            {{ item.title }}
        </a>

        <button 
          class="menu-toggle"
          aria-expanded="false"
          aria-label="Expand {{ item.title }}"
        >
          <span class="caret">▾</span>
        </button>

    </div>


    <div class="
      {% if level == 1 %}
        dropdown-menu
      {% else %}
        submenu-menu
      {% endif %}
    ">

        {{ renderNav(item.children, currentUrl, level + 1) }}

    </div>


{% else %}


    <a href="{{ item.url }}" class="nav-link {% if isActive %}active{% endif %}" {% if isActive %}aria-current="page"{% endif %}>
        {{ item.title }}
    </a>


{% endif %}


</div>


{% endfor %}

{% endmacro %}


<nav class="site-nav" aria-label="Primary navigation">

  {{ renderNav(navigation, page.url) }}

</nav>
