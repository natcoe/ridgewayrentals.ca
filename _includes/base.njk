<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    <!-- Open Graph -->
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}/images/ridgeway-rentals-logo.png">
    <meta property="og:image:alt" content="{{ site.name }} logo">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="{{ site.url }}/images/ridgeway-rentals-logo.png">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="/scripts/scripts.js" defer></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=apartment,assignment,attach_money,balance,build,calendar_check,calendar_month,call,check_circle,close,design_services,eco,expand_more,group,groups,handshake,handyman,history,home_repair_service,how_to_reg,inventory_2,local_shipping,location_on,mail,recycling,thumb_up,verified_user,web_traffic,workspace_premium" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Oswald:wght@200..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
  
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WasteManagementService",
        "name": "{{ site.name }}",
        "image": "{{ site.url }}/images/ridgeway-rentals-logo.png",
        "url": "{{ site.url }}",
        "telephone": "{{ site.phone }}",
        "email": "{{ site.email }}",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "{{ site.address.street }}",
          "addressLocality": "{{ site.address.city }}",
          "addressRegion": "{{ site.address.region }}",
          "postalCode": "{{ site.address.postalCode }}",
          "addressCountry": "{{ site.address.country }}"
        },
        "areaServed": [
          "Burlington",
          "Hamilton",
          "Oakville",
          "Milton",
          "Ancaster",
          "Dundas",
          "Stoney Creek",
          "Waterdown",
          "Grimsby",
          "Caledonia",
          "Southern Ontario"
        ],
        "openingHours": "Mo-Fr 08:00-17:00",
        "foundingDate": "{{ site.foundingYear }}"
      }
    </script>

    {% if breadcrumbs %}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{ site.url }}/"
          }{% for crumb in breadcrumbs %},
          {
            "@type": "ListItem",
            "position": {{ loop.index + 1 }},
            "name": "{{ crumb.name }}",
            "item": "{{ site.url }}{{ crumb.url }}"
          }{% endfor %}
        ]
      }
      </script>
    {% endif %}
  </head>
  <body>
    {% include "header.njk" %}

    <main>
      {{ content | safe }}
    </main>

    {% include "footer.njk" %}

  </body>
</html>