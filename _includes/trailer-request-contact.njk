<div class="contact-form-content">
  <div class="booking-form-heading">
    <p class="sub-title primary">Request a disposal bin</p>
    <h2 id="booking-modal-title">Tell us where to reach you</h2>
  </div>

  <p class="booking-price">
    <strong>$395 per dump</strong>
  </p>
  <p>
    Our disposal bins are available for a flat $395 per dump.
    Submit your preferred dates and project details and we'll confirm availability.
  </p>
  <br/>

  <form
    name="trailer-request"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="contact-form booking-modal-form booking-page-form"
  >
    <input type="hidden" name="form-name" value="trailer-request" />
    <p class="hidden">
      <label>
        Don't fill this out if you're human:
        <input name="bot-field" type="text" />
      </label>
    </p>

    <div class="booking-modal-date-row">
      <label>
        Drop off date
        <input type="date" name="drop-off-date" data-booking-drop-off placeholder="yyyy/mm/dd" required />
      </label>
      <label>
        Pick up date
        <input type="date" name="pick-up-date" data-booking-pick-up placeholder="yyyy/mm/dd" required />
      </label>
    </div>

    <div class="form-row">
      <input type="text" name="name" placeholder="Name*" required />
      <input type="email" name="email" placeholder="Email*" required />
      <input type="tel" name="phone" placeholder="Phone*" required />
    </div>

    <div class="form-row">
      <input type="text" name="address-line-1" placeholder="Address Line 1*" required />
      <input type="text" name="address-line-2" placeholder="Address Line 2 (Unit / Suite)" />
    </div>

    <div class="form-row">
      <input type="text" name="city" placeholder="City*" required />
      <input type="text" name="province" value="Ontario" readonly title="Province" />
      <input type="text" name="postal-code" placeholder="Postal Code*" required />
    </div>

    <textarea name="disposal-details" placeholder="What are you disposing of?*" rows="4" required></textarea>

    <button type="submit" class="btn btn-secondary">Request a Disposal Bin</button>

    <p class="micetype">
      Submitting this form is a request only. Your rental is not confirmed until a Ridgeway Rentals team member confirms availability.<br/><br/>
      We will be in touch soon to confirm your booking and collect payment details.
    </p>
  </form>

  <div
    class="booking-form-success"
    hidden
    role="status"
    aria-live="polite"
    tabindex="-1"
  >
    <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
    <h3>Thank you!</h3>
    <p>
      Your disposal bin request has been sent. We'll be in touch soon to confirm
      availability and payment details.
    </p>
  </div>
</div>