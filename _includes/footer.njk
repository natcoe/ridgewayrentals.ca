<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <img src="/images/ridgeway-rentals-logo.png" alt="{{ site.name }}" class="footer-logo" />
    </div>

    <div class="footer-col">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/how-it-works/">How It Works</a></li>
        <li><a href="/booking/">Booking</a></li>
        <li><a href="/faq/">FAQs</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Our Companies</h4>
      <ul>
        <li><a href="/">Ridgeway Services</a></li>
        <li><a href="#">Ramrock</a></li>
        <li><a href="#">Heritage</a></li>
        <li><a href="#">Painting</a></li>
        <li><a href="#">Bins</a></li>
        <li><a href="#">Storage</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contact</h4>
      <ul class="footer-contact">
        <li><a href="tel:{{ site.phone | replace('-', '') }}">{{ site.phone }}</a></li>
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><a href="{{ site.addressLink }}" target="_blank" rel="noopener noreferrer">{{ site.address.street }}, {{ site.address.city }}, {{ site.address.region }} {{ site.address.postalCode }}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-divider"></div>

  <div class="container footer-bottom">
    <p>&copy; {% year %} | {{ site.name }} All Rights Reserved.</p>
  </div>
</footer>