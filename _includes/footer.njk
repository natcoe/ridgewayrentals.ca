<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a href="/" class="logo">
        <img src="/images/ridgeway-rentals-logo.png" alt="{{ site.name }}" class="footer-logo" />
      </a>
    </div>

    <div class="footer-col">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/how-it-works/">How It Works</a></li>
        <li><a href="/booking/">Booking</a></li>
        <li><a href="/faq/">FAQs</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Our Companies</h4>
      <ul>
        <li><a href="http://www.ridgewayservices.ca">Ridgeway Services</a></li>
        <li><a href="#">Ramrock Electrical</a></li>
        <li><a href="#">Heritage Commercial Interiors</a></li>
        <li><a href="http://www.ridgewayrentals.ca">Ridgeway Disposal Solutions</a></li>
        <li><a href="#">Ridgeway Storage Rentals</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contact</h4>
      <ul class="footer-contact">
        <li><a href="tel:{{ site.phone | replace('-', '') }}">{{ site.phone }}</a></li>
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><a href="{{ site.addressLink }}" target="_blank" rel="noopener noreferrer">{{ site.address.street }}, {{ site.address.city }}, {{ site.address.region }} {{ site.address.postalCode }}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-divider"></div>

  <div class="footer-social">
    <ul class="footer-social">
      <li>
        <a href="{{ site.social.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Ridgeway Rentals on Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9.5"/>
            <path d="M14 8.5h-1.5A1.5 1.5 0 0 0 11 10v2m0 0H9m2 0v6.5m3-6.5h-3"/>
          </svg>
        </a>
      </li>
      <li>
        <a href="{{ site.social.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Ridgeway Rentals on Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4.2"/>
            <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none"/>
          </svg>
        </a>
      </li>
    </ul>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {% year %} | {{ site.name }} All Rights Reserved.</p>
  </div>
  <div class="container footer-bottom">
    <ul class="footer-legal">
      <li><a href="/privacy/">Privacy Policy</a></li>
      <li><a href="/terms/">Terms & Conditions</a></li>
    </ul>
  </div>
</footer>