    <!-- Bottom Contact Box -->
    <div class="faq-contact-box" data-reveal>
      <h3>Couldn't find the answer to your question?</h3>
      <p>Ask us here and our team will get back to you shortly:</p>

      <div class="faq-contact-grid">
        <div class="faq-question-form-content">
          <form name="faq-question" method="POST" data-netlify="true" class="contact-form faq-question-form">
          <input type="hidden" name="form-name" value="faq-question" />
          <div class="form-row">
            <input type="text" name="name" placeholder="Name*" required />
            <input type="email" name="email" placeholder="Email*" required />
            <input type="tel" name="phone" placeholder="Phone*" required />
          </div>
          <textarea name="question" placeholder="Ask your question here*" rows="4" required></textarea>
          <button type="submit" class="btn btn-secondary">Submit Question</button>
          </form>
          <div class="faq-form-success" hidden>
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <h4>Thank you!</h4>
            <p>Your question has been sent. We'll be in touch soon.</p>
          </div>
        </div>

        <div class="faq-direct-contact">
          <h4>Direct Contact</h4>
          <ul class="contact-details">
            <li>
              <span class="material-symbols-outlined">call</span>
              <a href="tel:{{ site.phone }}">{{ site.phone }}</a>
            </li>
            <li>
              <span class="material-symbols-outlined">mail</span>
              <a href="mailto:{{ site.email }}">{{ site.email }}</a>
            </li>
            <li>
              <span class="material-symbols-outlined">location_on</span>
              <a href="{{ site.addressLink }}" target="_blank" rel="noopener noreferrer">
                {{ site.address.street }}, {{ site.address.city }}, {{ site.address.region }} {{ site.address.postalCode }}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

